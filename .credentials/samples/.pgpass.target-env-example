# BEWARE TO NOT store this plain file into repository. Also, replace <THIS_SECRET_FILE>.target-env-example to <THIS_SECRET_FILE>.[local | dev | stage | replica | prod] 
# Each line is a connection
# Primary database hold main data
PRIMARY_SYS_HOST:PRIMARY_SYS_PORT:PRIMARY_SYS_DBNM:PRIMARY_SYS_USER:PRIMARY_SYS_PASS
PRIMARY_ADM_HOST:PRIMARY_ADM_PORT:PRIMARY_ADM_DBNM:PRIMARY_ADM_USER:PRIMARY_ADM_PASS
# Foreign database hold data expose to direct access for users in postgresql. Also hold data for geoprocessing.
FOREIGN_SYS_HOST:FOREIGN_SYS_PORT:FOREIGN_SYS_DBNM:FOREIGN_SYS_USER:FOREIGN_SYS_PASS
FOREIGN_ADM_HOST:FOREIGN_ADM_PORT:FOREIGN_ADM_DBNM:FOREIGN_ADM_USER:FOREIGN_ADM_PASS
# Postgres hold credential to execute a more privileged (but no for all DB!) action using DB postgres
POSTGRES_ADM_HOST:POSTGRES_ADM_PORT:POSTGRES_ADM_DBNM:POSTGRES_ADM_USER:POSTGRES_ADM_PASS
POSTGRES_READONLY_HOST:POSTGRES_READONLY_PORT:POSTGRES_READONLY_DBNM:POSTGRES_READONLY_USER:POSTGRES_READONLY_PASS
# For a generic user to run tests (it must have permission to create and drop databases). Generally use it with values -> *:*:*:POSTGRES_TEST_USER:POSTGRES_TEST_PASS
POSTGRES_TEST_HOST:POSTGRES_TEST_PORT:POSTGRES_TEST_DBNM:POSTGRES_TEST_USER:POSTGRES_TEST_PASS